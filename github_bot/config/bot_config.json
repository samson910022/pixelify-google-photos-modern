{
  "name": "Pixelify-Infinity-GitHub-AI-Bot",
  "version": "1.4.0",
  "description": "Issue investigation (quality score + root-cause hypotheses) and multi-agent PR code review for Pixelify Infinity using Grok, Gemini, Opus, and OpenCode fallback models. Optionally applies allowlisted suggested labels.",
  "llmConfigFile": "./config/LLM_config.example.json",
  "defaultProvider": "opencode",
  "commentMarker": "<!-- PIXELIFY_AI_REVIEW_REPORT -->",
  "triageMarker": "<!-- PIXELIFY_AI_TRIAGE_REPORT -->",
  "commandMarker": "<!-- PIXELIFY_AI_COMMAND_REPORT -->",
  "defaultBranchCandidates": [
    "master",
    "main"
  ],
  "maxDiffChars": 180000,
  "maxIssueBodyChars": 40000,
  "codingModels": [
    "gemini-3.7-flash-high",
    "grok-4.6",
    "claude-opus-4-6-thinking"
  ],
  "fallbackModels": [
    "gemini-3.7-flash-high",
    "grok-4.6",
    "claude-opus-4-6-thinking",
    "gemini-3.6-flash-high",
    "grok-composer-2.5-fast",
    "deepseek-v4-flash-free",
    "mimo-v2.5-free",
    "nemotron-3-ultra-free",
    "north-mini-code-free",
    "big-pickle"
  ],
  "fallbackModel": "gemini-3.7-flash-high",
  "dynamicModelDiscovery": true,
  "mediaOcr": {
    "enabled": true,
    "model": "gemini-3.7-flash-high",
    "fallbackModels": [
      "mimo-v2.5-free",
      "grok-4.6"
    ],
    "maxItems": 4,
    "maxBytesPerItem": 5000000,
    "maxSummaryChars": 12000,
    "timeoutSeconds": 300,
    "extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".bmp",
      ".mp4",
      ".webm",
      ".mov",
      ".mp3",
      ".wav",
      ".m4a",
      ".ogg"
    ]
  },
  "roles": {
    "identity_safety": {
      "model": "gemini-3.7-flash-high",
      "description": "Identity, signing, secrets, package/Xposed scope integrity reviewer",
      "promptFile": "./prompts/roles/reviewer_identity_safety.md",
      "temperature": 0.1,
      "maxTokens": 6144,
      "reasoningEffort": "high"
    },
    "android_xposed": {
      "model": "claude-opus-4-6-thinking",
      "description": "Android/Kotlin/Xposed behavior and regression reviewer",
      "promptFile": "./prompts/roles/reviewer_android_xposed.md",
      "temperature": 0.1,
      "maxTokens": 6144,
      "reasoningEffort": "high"
    },
    "docs_public": {
      "model": "gemini-3.7-flash-high",
      "description": "Public docs, templates, and contributor surface reviewer",
      "promptFile": "./prompts/roles/reviewer_docs_public.md",
      "temperature": 0.2,
      "maxTokens": 4096,
      "reasoningEffort": "high"
    },
    "triage_agent": {
      "model": "grok-4.6",
      "description": "Issue investigator: decision-first classification, quality scoring, thread-aware missing-info, root-cause hypotheses",
      "promptFile": "./prompts/roles/triage_agent.md",
      "temperature": 0.2,
      "maxTokens": 6144,
      "reasoningEffort": "high"
    },
    "explainer_agent": {
      "model": "grok-4.6",
      "description": "Plain-language PR explainer for maintainers",
      "promptFile": "./prompts/roles/explainer_agent.md",
      "temperature": 0.3,
      "maxTokens": 4096,
      "reasoningEffort": "high"
    }
  },
  "reviewPipeline": [
    "identity_safety",
    "android_xposed",
    "docs_public"
  ],
  "sensitivePathGlobs": [
    ".github/workflows/**",
    "certificates/**",
    "gradle/wrapper/**",
    "gradlew",
    "gradlew.bat",
    "app/build.gradle.kts",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle/libs.versions.toml",
    "update_info.json",
    "docs/RELEASE_SIGNING.md",
    "docs/PUBLICATION_CHECKLIST.md",
    "scripts/check-publication-readiness.py",
    "scripts/verify-release-artifacts.py",
    "github_bot/**"
  ],
  "slashCommands": {
    "/review": "On PRs: multi-agent code review. On issues: issue investigation.",
    "/triage": "Issue investigation with quality score and missing-info checklist",
    "/explain": "On PRs: plain-language explanation. On issues: issue investigation."
  },
  "triage": {
    "minResponseChars": 400,
    "requiredSections": [
      "CLASSIFICATION",
      "ACTIONABILITY",
      "SUMMARY",
      "EVIDENCE_USED",
      "ROOT_CAUSE_HYPOTHESES",
      "REPORTER_NEXT_STEPS",
      "MAINTAINER_NEXT_STEPS",
      "SUGGESTED_LABELS",
      "ISSUE_QUALITY_SCORE",
      "QUALITY_BREAKDOWN",
      "MISSING_INFO",
      "RISK",
      "SECURITY_ROUTING"
    ],
    "failClosedOnIncomplete": true,
    "publishIncompleteStub": true,
    "maxThreadCommentChars": 12000,
    "thread": {
      "enabled": true,
      "maxComments": 30,
      "maxChars": 20000,
      "excludeBotMarkers": true
    },
    "applySuggestedLabels": true,
    "labelAllowlist": [
      "bug",
      "documentation",
      "enhancement",
      "question",
      "needs-info",
      "needs-triage",
      "device-specific",
      "android-17",
      "android-16",
      "photos-version",
      "security",
      "likely-user-setup",
      "feature-request",
      "support",
      "duplicate",
      "invalid",
      "wontfix",
      "good first issue",
      "help wanted"
    ]
  },
  "llmResponseGate": {
    "rejectFinishReasons": [
      "length",
      "max_tokens",
      "content_filter"
    ],
    "minResponseChars": 0,
    "sameModelRetryOnLength": 1
  }
}
