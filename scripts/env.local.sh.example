# Copy to scripts/env.local.sh (gitignored) and edit for this machine.
# Used by scripts/with-android-env.sh for local builds and agent shells.
#
# Do not commit env.local.sh. Do not put signing passwords here.

export JAVA_HOME="${JAVA_HOME:-$HOME/Android/jdk-17}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
export PATH="$JAVA_HOME/bin:$PATH"
